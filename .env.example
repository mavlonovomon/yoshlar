# Django Settings
SECRET_KEY=your-secret-key-here-change-in-production
DEBUG=True
DJANGO_DEBUG=True
MUTOLAA_STATS_URL=https://api.mutolaa.com/api/v1/stats/NeighborhoodForStatistics/?offset=0&limit=47&parent__parent=8649&ordering&parent=8857
USTOZ_AI_STATS_URL=https://api.ustozaibot.uz/api/v1/statistics-cached/village-school?district=Xazorasp+tumani&region=Xorazm+viloyati
UZCHESS_STATS_URL=https://api.uzchesss.uz/api/statistics/count-by-neighborhood?page=1&region=Xorazm+viloyati&district=Xazorasp+tumani
QIZLAR_STATS_URL=https://api.qizlarakademiyasi.uz/api/statistics/count-by-neighborhood?page=1&region=Xorazm+viloyati&district=Xazorasp+tumani&sortBy=profiles

# AI-assisted report (optional)
OPENAI_API_KEY=sk-edbf9aa2b8314de280144423658a15bd
REPORT_AI_MODEL=gemini-3-flash
REPORT_AI_BASE_URL=http://127.0.0.1:8045/v1
REPORT_FONT_PATH=
REPORT_FONT_BOLD_PATH=

# Allowed hosts (comma-separated)
ALLOWED_HOSTS=127.0.0.1,localhost,example.com,www.example.com

# Database
# PostgreSQL uchun misol:
# DATABASE_URL=postgresql://yoshlar_user:strong_password@127.0.0.1:5432/yoshlar
# SQLite fallback:
DATABASE_URL=sqlite:///yoshlar.db
SQLITE_PATH=/var/www/yoshlar/shared/db/yoshlar.db

# Reverse proxy / Cloudflare Tunnel
CSRF_TRUSTED_ORIGINS=https://example.com,https://www.example.com
USE_X_FORWARDED_HOST=True
SECURE_PROXY_SSL_HEADER=True
SESSION_COOKIE_SECURE=True
CSRF_COOKIE_SECURE=True
SECURE_SSL_REDIRECT=False
SECURE_HSTS_SECONDS=0

# OneID Settings
ONEID_CLIENT_ID=your-oneid-client-id
ONEID_CLIENT_SECRET=your-oneid-client-secret
ONEID_REDIRECT_URI=https://example.com/auth/oneid/callback/
ONEID_AUTH_URL=https://sso.egov.uz/sso/oauth/Authorization.do
ONEID_TOKEN_URL=https://sso.egov.uz/sso/oauth/Authorization.do


# Persistent file paths (recommended for deployment)
MEDIA_ROOT=/var/www/yoshlar/shared/media
STATIC_ROOT=/var/www/yoshlar/shared/staticfiles

# Gunicorn / systemd
GUNICORN_BIND=127.0.0.1:8000
GUNICORN_WORKERS=3
GUNICORN_TIMEOUT=120
SYSTEMD_SERVICE_NAME=yoshlar

# Admin credentials
ADMIN_PASSWORD=secure-password-here

# Email (optional)
EMAIL_BACKEND=django.core.mail.backends.console.EmailBackend
