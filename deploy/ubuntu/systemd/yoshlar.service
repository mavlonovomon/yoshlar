[Unit]
Description=Yoshlar Django app (Gunicorn)
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=genius
Group=genius
WorkingDirectory=/var/www/yoshlar/repo
EnvironmentFile=/var/www/yoshlar/shared/.env
Environment=PYTHONUNBUFFERED=1
ExecStart=/var/www/yoshlar/venv/bin/gunicorn config.wsgi:application --bind 127.0.0.1:8000 --workers 3 --timeout 120 --access-logfile /var/www/yoshlar/shared/logs/gunicorn-access.log --error-logfile /var/www/yoshlar/shared/logs/gunicorn-error.log --capture-output
Restart=on-failure
RestartSec=5
PrivateTmp=true
NoNewPrivileges=true

[Install]
WantedBy=multi-user.target
